<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-checks the port's LiteDB reader and writer (crates/playnite) against the real LiteDB 4.1.4 that Playnite 10
       uses, with Playnite's own models from its SDK: docs/import.md, "How sure". Not built by CI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The SDK and LiteDB 4 are .NET Framework / .NET Standard libraries: they load here. -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="4.1.4" />
    <PackageReference Include="PlayniteSDK" Version="6.18.0" />
  </ItemGroup>
</Project>
